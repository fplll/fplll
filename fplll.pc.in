prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

defaultstrategydir=@DEFAULTSTRATEGYDIR@
defaultstrategy=@DEFAULTSTRATEGY@

Name: @PACKAGE_NAME@
Description: lattice algorithms with floating-point computations
Version: @PACKAGE_VERSION@
Cflags: -I${includedir} @LIBQD_CFLAGS@ @PTHREAD_CFLAGS@ @MPFR_CFLAGS@ @GMP_CFLAGS@
Libs: -L${libdir} -lfplll @LIBQD_LIBS@ @PTHREAD_LIBS@ @MPFR_LIBS@ @GMP_LIBS@
